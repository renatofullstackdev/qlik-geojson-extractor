{
  "manifest_version": 3,
  "name": "Qlik GeoJSON Extractor",
  "short_name": "Qlik GeoJSON",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Inspeciona PointLayers do Qlik Sense, valida a entidade espacial e exporta GeoJSON de forma auditável.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Qlik GeoJSON Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
